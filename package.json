{
  "name": "mqemitter-redis",
  "version": "8.0.0",
  "description": "Redis-based MQEmitter",
  "main": "mqemitter-redis.js",
  "types": "types/mqemitter-redis.d.ts",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hyperid": "^4.0.0",
    "inherits": "^2.0.4",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "mqemitter": "^7.1.0",
    "msgpack-lite": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "neostandard": "^0.14.0",
    "tstyche": "^7.2.5",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "lint:fix": "eslint --fix",
    "lint": "eslint",
    "unit": "node --test --test-concurrency=1 test/*.js",
    "test:types": "tstyche",
    "typescript": "tsc --project ./test/types/tsconfig.json",
    "test": "npm run lint && npm run unit && npm run test:types && npm run typescript",
    "redis": "docker run -d --rm --name redis -p 6379:6379 redis:7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mcollina/mqemitter-redis.git"
  },
  "keywords": [
    "redis",
    "mqemitter",
    "emitter",
    "pubsub",
    "publish",
    "subscribe"
  ],
  "author": "Matteo Collina <hello@matteocollina.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mcollina/mqemitter-redis/issues"
  },
  "homepage": "https://github.com/mcollina/mqemitter-redis"
}
